{
  "name": "@dodaijs/vite",
  "version": "0.1.0",
  "description": "Vite plugin for dodai: import SQLite schemas, check them at build time and generate row types",
  "keywords": [
    "cloudflare",
    "durable-objects",
    "schema",
    "sqlite",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/dodaijs/dodai/tree/main/packages/vite#readme",
  "bugs": {
    "url": "https://github.com/dodaijs/dodai/issues"
  },
  "license": "MIT",
  "author": {
    "name": "ktsujichan",
    "url": "https://github.com/ktsujichan"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dodaijs/dodai.git",
    "directory": "packages/vite"
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dodaijs/core": "workspace:^"
  },
  "devDependencies": {
    "vite": "8.3.1"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "engines": {
    "node": ">=22.13"
  }
}
